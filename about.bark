[html lang=en
  [head
    [meta charset=utf-8]
    [meta content="width=device-width, initial-scale=1" name=viewport]
    [title About — Sergey Denisov]
    [link href=icon.png rel=icon type=image/png]
    [link href=site.css rel=stylesheet]
    [script src=https://unpkg.com/lucide@latest/dist/umd/lucide.min.js]
  ]
  [body
    [header :site-header data-screen-label=Header
      [:shell
        [a :wordmark aria-label=Home href=index.html
          [span :dot]
          [span Sergey Denisov]
        ]
        [nav :nav aria-label=Primary
          [a href=index.html | Home]
          [a href=projects.html | Experience]
          [a :is-active href=about.html | About]
          [a href=contact.html | Contact]
        ]
      ]
    ]
    [main data-screen-label=About
      [:shell
        [:page-stack
          [:page-head
            [:eyebrow | // background]
            [h1 :title | Background]
            [p :lede | A few notes on the technical background and interests that shaped how I approach engineering.]
          ]
          [:prose
            [ul :about-list
              [li I grew up and studied in the Russian Far East, much closer to China than to Moscow, and earned a master’s degree in computer systems analysis.]
              [li My university work included C++, x86 assembly, and assembly for an embedded RISC controller. That low-level foundation still influences how I think about performance, concurrency, and system boundaries.]
              [li I later moved into Java and built an early chat application with applets and AWT. Since then, I have worked with languages including Perl, Scala, Go, and TypeScript.]
              [li After university, I pursued graduate study and taught database and networking courses at my alma mater for two semesters. Teaching reinforced the value of explaining complex systems clearly and precisely.]
              [li Outside work, I am learning Spanish. Learning a third language has been a very different experience from learning a second one.]
            ]
          ]
        ]
      ]
    ]
    [footer :site-footer
      [:shell
        [span :colophon | © 2026 Sergey Denisov]
        [:links
          [a href=https://github.com/sergey5d rel=noreferrer target=_blank | GitHub]
          [a href=https://www.linkedin.com/in/sadenisov/ rel=noreferrer target=_blank | LinkedIn]
          [a href=contact.html | Contact]
        ]
      ]
    ]
    [script lucide.createIcons();]
  ]
]
