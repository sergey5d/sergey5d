[html lang=en
  [head
    [meta charset=utf-8]
    [meta content="width=device-width, initial-scale=1" name=viewport]
    [title Sergey Denisov — Staff Backend Engineer]
    [link href=icon.png rel=icon type=image/png]
    [link href=site.css rel=stylesheet]
    [script src=https://unpkg.com/lucide@latest/dist/umd/lucide.min.js]
  ]
  [body
    [header :site-header data-screen-label=Header
      [:shell
        [a :wordmark aria-label=Home href=index.html
          [span :dot]
          [span Sergey Denisov]
        ]
        [nav :nav aria-label=Primary
          [a :is-active href=index.html | Home]
          [a href=projects.html | Experience]
          [a href=about.html | About]
          [a href=contact.html | Contact]
        ]
      ]
    ]
    [main data-screen-label=Home
      [:shell
        [:page-stack
          [:page-head
            [:eyebrow | Tampa, FL · Remote US]
            [h1 :title | Staff Backend Engineer]
            [p :lede | I design and build distributed backend systems for trading and financial platforms, with an emphasis on correctness, observability, and production reliability.]
          ]
          [:prose
            [p For more than 15 years, I have worked across exchange infrastructure, credit derivatives, order management, settlement, messaging, and APIs. I lead projects from ambiguous requirements through design, delivery, and production ownership.]
            [p Most recently, I was a Staff Software Engineer at Gemini. Before that, I held senior engineering roles at Morgan Stanley and Markit.]
            [p
              [a :link href=projects.html | Experience →]
              ·
              [a :link href=contact.html | Contact →]
            ]
          ]
        ]
      ]
    ]
    [footer :site-footer
      [:shell
        [span :colophon | © 2026 Sergey Denisov]
        [:links
          [a href=https://github.com/sergey5d rel=noreferrer target=_blank | GitHub]
          [a href=https://www.linkedin.com/in/sadenisov/ rel=noreferrer target=_blank | LinkedIn]
          [a href=contact.html | Contact]
        ]
      ]
    ]
    [script lucide.createIcons();]
  ]
]
