[html lang=en
  [head
    [meta charset=utf-8]
    [meta content="width=device-width, initial-scale=1" name=viewport]
    [title Experience — Sergey Denisov]
    [link href=icon.png rel=icon type=image/png]
    [link href=site.css rel=stylesheet]
    [script src=https://unpkg.com/lucide@latest/dist/umd/lucide.min.js]
  ]
  [body
    [header :site-header data-screen-label=Header
      [:shell
        [a :wordmark aria-label=Home href=index.html
          [span :dot]
          [span Sergey Denisov]
        ]
        [nav :nav aria-label=Primary
          [a href=index.html | Home]
          [a :is-active href=projects.html | Experience]
          [a href=about.html | About]
          [a href=contact.html | Contact]
        ]
      ]
    ]
    [main data-screen-label=Experience
      [:shell
        [:page-stack
          [:page-head
            [:eyebrow | // experience]
            [h1 :title | Experience]
            [p :lede | More than 15 years building and operating backend systems across crypto exchange infrastructure, credit derivatives, KYC, and financial content platforms.]
          ]
          [section :experience
            [article :experience-item
              [:experience-head
                [
                  [h2 Gemini]
                  [p :experience-role | Staff Software Engineer · Order Management]
                ]
                [:experience-meta
                  [span Remote (US)]
                  [span :tnum | 2022 – Feb 2026]
                ]
              ]
              [p :experience-summary | Order management, settlement, and operational systems for a crypto exchange and custodian supporting spot and derivatives trading.]
              [p :experience-env
                [strong Core technologies:]
                Scala, Go, Kafka, gRPC, PostgreSQL, Redis, Kubernetes, and AWS
              ]
              [ul :experience-points
                [li Led a team of four engineers, providing technical direction and owning delivery, code quality, mentoring, and production readiness.]
                [li Led the transition from hardcoded asset and instrument definitions to service-managed configuration across SBE messages, database schemas, and a large monorepo. Delivered validated, audited self-service tooling that removed routine engineering involvement.]
                [li Designed dynamic restrictions for 5,000 instruments and 300,000 rules, introducing business-entity–based evaluation, caching, migration from legacy logic, and audited self-service administration.]
                [li Built the backend for derivatives incentives and leaderboards, including reproducible P&L and ROI calculations, eligibility rules, scheduled winner selection, notifications, and APIs.]
                [li Contributed to multi-asset institutional settlement and improved customer-facing order lifecycle and onboarding flows, including ledger interactions for transaction state and account balances.]
                [li Owned operational readiness for customer-facing services through safe release practices, Datadog dashboards and monitors, and runbooks for order-ingress pipelines.]
              ]
            ]
            [article :experience-item
              [:experience-head
                [
                  [h2 Morgan Stanley]
                  [p :experience-role | Vice President / Senior Software Engineer · Credit Derivatives]
                ]
                [:experience-meta
                  [span New York, NY]
                  [span :tnum | 2015 – 2022]
                ]
              ]
              [p :experience-summary | Tradeflow: CDS ledger and lifecycle platform for credit derivatives, used by Operations and integrated with client trading and settlement systems across New York, London, and Hong Kong.]
              [p :experience-env
                [strong Core technologies:]
                Java, Scala, Akka Streams, Kafka, Sybase, and Spring
              ]
              [ul :experience-points
                [li Built a Scala, Akka Streams, and Kafka integration that moved trade data from a legacy Java platform into a next-generation risk system.]
                [li Delivered Book Move automation for moving thousands to tens of thousands of trades: automated account adjustments, fee-trade generation, and reporting. Implemented a two-phase rollout culminating in redesigned accounting behavior that retained realized payments and moved only unrealized ones, reducing operational risk.]
                [li Overhauled credit-event tooling by improving trade eligibility discovery, reference-entity and portfolio-version updates, and fee application. Reduced execution time and eliminated routine developer involvement.]
                [li Re-architected synchronization of back-to-back trades with parent trades; reduced incidents from 2–3 per week to roughly 1–2 every 6 months, with the remaining issues largely unrelated to sync logic.]
                [li Delivered workflow and state-machine changes, trade maturation reporting, and batch processing for evolving credit-derivatives requirements.]
                [li Drove defect reduction and production-stability improvements, shifting support rotations from high-volume firefighting to mostly external integration issues.]
              ]
            ]
            [article :experience-item
              [:experience-head
                [
                  [h2 Markit (now part of S&P Global)]
                  [p :experience-role | Vice President / Senior Software Engineer]
                ]
                [:experience-meta
                  [span New York, NY]
                  [span :tnum | 2009 – 2015]
                ]
              ]
              [p :experience-summary | Lead engineer for Genpact KYC Services and Markit Hub, spanning secure portals, APIs, SSO, publishing pipelines, partner integrations, and production reliability.]
              [p :experience-env
                [strong Core technologies:]
                Java, Oracle, Tomcat, Spring, OAuth, and AngularJS
              ]
              [ul :experience-points
                [li Led design and delivery for Genpact KYC Services, including a secure portal, API workflows, and integration services for KYC data and subscriptions.]
                [li Led engineering for Markit Hub, a financial-content aggregation and SSO platform with provider integrations and publishing pipelines across SOAP, CSV, and RSS.]
                [li Owned platform migrations and reliability improvements across internal and partner-facing services.]
              ]
            ]
          ]
          [section :section
            [:section-head
              [h2 Education]
            ]
            [:prose
              [p
                [strong Master of Science, Computer Systems Analysis]
                · Pacific National University, Russia
              ]
            ]
          ]
        ]
      ]
    ]
    [footer :site-footer
      [:shell
        [span :colophon | © 2026 Sergey Denisov]
        [:links
          [a href=https://github.com/sergey5d rel=noreferrer target=_blank | GitHub]
          [a href=https://www.linkedin.com/in/sadenisov/ rel=noreferrer target=_blank | LinkedIn]
          [a href=contact.html | Contact]
        ]
      ]
    ]
    [script lucide.createIcons();]
  ]
]
